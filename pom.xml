<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.courel</groupId>
    <artifactId>lammprimante</artifactId>
    <version>1.3</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jdk.win.home>${user.home}/tools/jdk25-win</jdk.win.home>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>
        <dependency>
            <groupId>fr.courel</groupId>
            <artifactId>lammui</artifactId>
            <version>1.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.txt</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.txt</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fr.courel.lammprimante.App</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.5.2</version>
                <executions>
                    <execution>
                        <id>wrap-exe</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>gui</headerType>
                            <outfile>${project.build.directory}/Lammprimante.exe</outfile>
                            <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                            <errTitle>Lammprimante</errTitle>
                            <icon>${project.basedir}/src/main/resources/logo.ico</icon>
                            <jre>
                                <path>./jre</path>
                                <minVersion>25</minVersion>
                            </jre>
                            <versionInfo>
                                <fileVersion>1.0.0.0</fileVersion>
                                <txtFileVersion>1.0</txtFileVersion>
                                <fileDescription>Lammprimante</fileDescription>
                                <copyright>Jeremy</copyright>
                                <productVersion>1.0.0.0</productVersion>
                                <txtProductVersion>1.0</txtProductVersion>
                                <productName>Lammprimante</productName>
                                <internalName>lammprimante</internalName>
                                <originalFilename>Lammprimante.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dist-win</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jlink-win</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <fail message="JDK Windows introuvable : ${jdk.win.home}/jmods. Télécharger Liberica JDK Full 25 Windows et extraire dans ${jdk.win.home}.">
                                            <condition>
                                                <not>
                                                    <available file="${jdk.win.home}/jmods" type="dir"/>
                                                </not>
                                            </condition>
                                        </fail>
                                        <delete dir="${project.build.directory}/jre-win" quiet="true"/>
                                        <exec executable="jlink" failonerror="true">
                                            <arg value="--module-path"/>
                                            <arg value="${jdk.win.home}/jmods"/>
                                            <arg value="--add-modules"/>
                                            <arg value="java.base,java.desktop,java.logging,java.prefs"/>
                                            <arg value="--no-header-files"/>
                                            <arg value="--no-man-pages"/>
                                            <arg value="--compress=zip-6"/>
                                            <arg value="--output"/>
                                            <arg value="${project.build.directory}/jre-win"/>
                                        </exec>
                                        <delete dir="${project.build.directory}/dist-staging" quiet="true"/>
                                        <mkdir dir="${project.build.directory}/dist-staging/Lammprimante"/>
                                        <copy file="${project.build.directory}/Lammprimante.exe" todir="${project.build.directory}/dist-staging/Lammprimante"/>
                                        <copy todir="${project.build.directory}/dist-staging/Lammprimante/jre">
                                            <fileset dir="${project.build.directory}/jre-win"/>
                                        </copy>
                                        <zip destfile="${project.build.directory}/Lammprimante-Windows.zip"
                                             basedir="${project.build.directory}/dist-staging"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
